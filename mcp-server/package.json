{
  "name": "sandbox-knowledge-hub-mcp",
  "version": "0.2.0",
  "description": "MCP server exposing the Zurich AI Innovation Sandbox Knowledge Hub wiki to any MCP-capable AI assistant",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "worker"
  ],
  "bin": {
    "sandbox-hub-mcp": "dist/stdio.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/build-bundle.ts",
    "bundle": "tsx scripts/build-bundle.ts",
    "dev": "tsx src/stdio.ts",
    "start": "node dist/stdio.js",
    "start:http": "tsx src/http.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:http": "node --import tsx scripts/check-workers.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "gray-matter": "^4.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@hono/node-server": "1.19.17"
  }
}
